# Vorlage für Kunden-Builds. Als .env.<kunde> kopieren (wird nicht committet) und bauen mit
#   npx tauri build --config src-tauri/tauri.<kunde>.conf.json
# Die tauri.<kunde>.conf.json setzt beforeBuildCommand auf "npm run build -- --mode <kunde>"
# und die Tauri-CSP mit denselben Servern wie VITE_CSP_EXTRA.

# Anmeldung am Kundenportal
VITE_PORTAL_AUTH_URL=https://portal.example.com/api/auth.php

# „Problem gelöst“: Webhook in der n8n-Instanz des Kunden
VITE_SOLVED_WEBHOOK_URL=https://n8n.example.com/webhook/chat-solved

# Zusätzlich erlaubte Server in der CSP von index.html (connect-src und img-src), durch Leerzeichen getrennt
VITE_CSP_EXTRA=https://portal.example.com https://n8n.example.com

# off: kein Auto-Update aus den allgemeinen GitHub-Releases
VITE_UPDATER=off

# off: Verlauf nicht vom Server laden (nur sinnvoll, wenn der Verlauf-Workflow das Token prüft)
VITE_SERVER_HISTORY=off
